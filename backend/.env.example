# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
HOST_URL=http://localhost:8080/

# ── Database (PostgreSQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearzy
DB_USER=postgres
DB_PASS=

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24
ADMIN_PASSWORD=

# ── Mail ────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── Razorpay ────────────────────────────────────────────────────────
# From the Razorpay dashboard: Settings > API Keys.
# KEY_ID is served to the app via GET /customer/payment/config.
# KEY_SECRET signs and verifies payments and must never leave the server.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
