# Copy to .env and fill in. .env is gitignored — never commit real credentials.

# ── Server ──────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
HOST_URL=http://localhost:8080/

# ── Database (PostgreSQL) ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nearzy
DB_USER=postgres
DB_PASS=

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_EXPIRATION_HOURS=24
# Refresh-token lifetime. The app rotates its refresh token on every use, so
# a session survives this long of inactivity before a password is needed again.
JWT_REFRESH_EXPIRATION_DAYS=30
# Overrides JWT_EXPIRATION_HOURS when > 0. Set to 1 to watch the app's refresh
# path run every minute; leave unset (or 0) outside of testing.
JWT_EXPIRATION_MINUTES=0
# The seeded admin account. ADMIN_EMAIL defaults to admin@nearzy.com.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Mail ────────────────────────────────────────────────────────────
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=

# ── Razorpay ────────────────────────────────────────────────────────
# From the Razorpay dashboard: Settings > API Keys.
# KEY_ID is served to the app via GET /customer/payment/config.
# KEY_SECRET signs and verifies payments and must never leave the server.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ── Background jobs ─────────────────────────────────────────────────
# Off by default. The replenishment and markdown jobs write shared state, so
# two instances against one database would each raise the same alerts and
# `nodemon` restarting on every save would re-run them constantly.
ENABLE_JOBS=false
JOBS_TIMEZONE=Asia/Kolkata

# ── Seeding ─────────────────────────────────────────────────────────
# `node src/seed.js` refuses to run once real users exist, so one signup does
# not block the whole seed. Set to 1 to seed alongside them anyway.
SEED_FORCE=0

# ── Listing assistant (Google AI Studio) ────────────────────────────
# Reads a product photo and drafts the listing so a shop owner confirms
# fields instead of typing seven of them. Get a key at aistudio.google.com.
#
# Entirely optional: without it POST /shop/products/draft answers 503
# DRAFT_UNAVAILABLE and the upload form still works by hand. It never drafts a
# price — that is always the owner's own input.
GEMINI_API_KEY=
# Override only to try a different model; the default is a current vision model.
GEMINI_MODEL=
# Ceiling on one photo-read, in ms. Free-tier latency is very uneven — the
# same request measured 14s once and over 90s another time — so this exists
# to hand the shopkeeper back a usable form instead of an endless spinner.
GEMINI_TIMEOUT_MS=25000
